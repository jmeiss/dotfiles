# ~/.zshrc — symlinked from ~/dotfiles by install.sh.
# Secrets and machine-only tweaks go in ~/.zshrc.local (never committed).

# Powerlevel10k instant prompt. Keep near the top; anything needing console input goes above.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Repo root, resolved through the ~/.zshrc symlink.
DOTFILES="${${(%):-%x}:A:h:h}"

# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git)
source "$ZSH/oh-my-zsh.sh"

case "$OSTYPE" in
  darwin*) source "$DOTFILES/zsh/macos.zsh" ;;
  linux*)  source "$DOTFILES/zsh/linux.zsh" ;;
esac

source "$DOTFILES/zsh/functions.zsh"
source "$DOTFILES/zsh/aliases.zsh"

# Prompt layout (`p10k configure` to change it).
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
